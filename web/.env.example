DATABASE_URL= # url do mongodb + /nome-da-db

GOOGLE_ID= # https://console.cloud.google.com/apis/
GOOGLE_SECRET= # https://console.cloud.google.com/apis/

# provedor de email (resend)
# também é possível usar nodemailer, mailjet e outros, essa aqui é só uma sugestão
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM="Your App <noreply@updates.yourdomain.com>"

BETTER_AUTH_URL="http://localhost:3000" # IMPORTANTE MANTER CERTO se usa rotas como a de forgot password
BETTER_AUTH_SECRET= # gerar usando o comando: openssl rand -base64 32

# o posthog é um esquema de analytics que usei pro noctiluz, favor desconsiderar
# se quiser usá-lo ele vai gerar as coisas parecidas com o abaixo
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# AWS tem muitos servicos diferentes que usamos, como o S3
# os 3 primeiros são a base e o 4° se refere ao s3
# usado para o upload de imagens de capa dos blogs - o bucket precisa ter uma
# policy de leitura pública (ou ficar atrás de um CloudFront) pra imagens aparecerem
AWS_ACCESS_KEY_ID= # access key do usuário iam
AWS_SECRET_ACCESS_KEY= # secret da access key do iam
AWS_REGION= # "us-east-2" por exemplo

AWS_S3_BUCKET= # 'bucket-x' por exemplo

# chave da Anthropic para geração das respostas do chat (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# chave da Voyage AI para gerar embeddings dos documentos (https://dash.voyageai.com/)
VOYAGE_API_KEY=

# nome do índice de vector search criado no Atlas (na collection documentChunk, campo "embedding")
# IMPORTANTE: precisa ser um cluster MongoDB Atlas (não community/self-hosted) - Atlas Search
# é feature exclusiva do Atlas. Criar o índice manualmente pelo Atlas UI/Admin API:
# { "fields": [{ "type": "vector", "path": "embedding", "numDimensions": 1024, "similarity": "cosine" }] }
ATLAS_VECTOR_INDEX=chunk_vector_index
